{
  base: {
    border: {
      radius: {
        $type: "dimension",
        "125": {
          $value: {
            value: 5,
            unit: "px"
          }
        },
        "150": {
          $value: {
            value: 6,
            unit: "px"
          }
        },
        "200": {
          $value: {
            value: 8,
            unit: "px"
          }
        },
        "300": {
          $value: {
            value: 12,
            unit: "px"
          }
        },
        full: {
          $value: {
            value: 9999,
            unit: "px"
          }
        }
      }
    }
  }
}
