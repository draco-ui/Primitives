{
  text: {
    heading: {
        $type: "typography",
        "3xl": {
            $value: {
            fontSize: "{font.size.4xl}",
            fontFamily: "{font.family.sans}",
            fontWeight: "{font.weight.bold}",
            lineHeight: "{base.typography.height.1200}",
            letterSpacing: "{font.letter-spacing.densest}"
            }
        },
        "2xl": {
            $value: {
            fontSize: "{font.size.3xl}",
            fontFamily: "{font.family.sans}",
            fontWeight: "{font.weight.bold}",
            lineHeight: "{base.typography.height.1000}",
            letterSpacing: "{font.letter-spacing.denser}"
            }
        },
        xl: {
            $value: {
            fontSize: "{font.size.2xl}",
            fontFamily: "{font.family.sans}",
            fontWeight: "{font.weight.bold}",
            lineHeight: "{font.line-height.loose}",
            letterSpacing: "{font.letter-spacing.dense}"
            }
        },
        lg: {
            $value: {
            fontSize: "{font.size.xl}",
            fontFamily: "{font.family.sans}",
            fontWeight: "{font.weight.semi-bold}",
            lineHeight: "{font.line-height.normal}",
            letterSpacing: "{font.letter-spacing.dense}"
            }
        },
        md: {
            $value: {
            fontSize: "{font.size.sm}",
            fontFamily: "{font.family.sans}",
            fontWeight: "{font.weight.semi-bold}",
            lineHeight: "{font.line-height.snug}",
            letterSpacing: "{font.letter-spacing.normal}"
            }
        },
        sm: {
            $value: {
            fontFamily: "{font.family.sans}",
            fontSize: "{base.typography.size.325}",
            fontWeight: "{font.weight.semi-bold}",
            lineHeight: "{font.line-height.snug}",
            letterSpacing: "{font.letter-spacing.normal}"
            }
        },
        xs: {
            $value: {
            fontSize: "{font.size.xs}",
            fontFamily: "{font.family.sans}",
            fontWeight: "{font.weight.semi-bold}",
            lineHeight: "{font.line-height.tight}",
            letterSpacing: "{font.letter-spacing.normal}"
            }
        }
    }
  }
}
