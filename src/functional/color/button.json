{
    "color": {
        "button": {
            "$type": "color",
            "primary": {
                "background": {
                    "default": {
                        "$value": "{product.corinvo.color.primary.default}"
                    },
                    "hovered": {
                        "$value": "{product.corinvo.color.primary.hovered}"
                    },
                    "disabled": {
                        "$value": "{base.color.neutral.100}",
                        "$extensions": {
                            "mode": {
                                "dark": "{base.color.neutral.900}"
                            }
                        }
                    }
                },
                "foreground": {
                    "$value": "{base.color.neutral.950}"
                },
                "border": {
                    "$value": {
                        "colorSpace": "srgb",
                        "components": [0.1255,0.1255,0.1255],
                        "alpha": 1
                    },
                    "$extensions": {
                        "mode": {
                            "dark": "{product.corinvo.color.primary.default}"
                        }
                    }
                },
                "shadow": {
                    "$value": {
                        "colorSpace": "srgb",
                        "components": [0.1255,0.1255,0.1255],
                        "alpha": 1
                    },
                    "$extensions": {
                        "mode": {
                            "dark": {
                                "colorSpace": "srgb",
                                "components": [0.2118,0.2392,0.0627],
                                "alpha": 1
                            }
                        }
                    }
                }
            },
            "secondary": {}
        }
    }
}