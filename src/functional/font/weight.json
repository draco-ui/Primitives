{
  "font": {
    "weight": {
      "$type": "fontWeight",
      "light": {
        "$value": "{base.typography.weight.300}"
      },
      "regular": {
        "$value": "{base.typography.weight.400}"
      },
      "medium": {
        "$value": "{base.typography.weight.500}"
      },
      "semi-bold": {
        "$value": "{base.typography.weight.600}"
      },
      "bold": {
